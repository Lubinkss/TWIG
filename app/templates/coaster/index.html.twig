{% extends 'base.html.twig' %}

{% block title %}Maison{% endblock %}
{% block body %}
<div class="flex justify-end my-4">
    <a class="btn btn-neutral" href="{{ path('app_coaster_add') }}"> Nouveau coaster </a>


        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Vitesse</th>
                    <th>Durée</th>
                    <th>Hauteur</th>
                    <th>Opérationel</th>
                    <th>Edit</th>
                    <th>Suppression</th>
                    <th>Park</th>
                </tr>
            </thead>

            <tbody>
        {%for coaster in coasters %}
            <tr>
                <td>{{ coaster.name}}</td>
                <td>{{coaster.maxSpeed}}</td>
                <td>{{coaster.length}}</td>
                <td>{{coaster.maxHeight}}</td>
                <td>{{coaster.operating}}</td>
                <td><a class="btn btn-neutral" href="{{ path('app_coaster_edit', { id: coaster.id }) }}"> Modifier </a></td>
                <td><a class="btn btn-neutral" href="{{ path('app_coaster_delete', { id: coaster.id }) }}"> Supprimer </a></td>
                <td>{{coaster.getPark()}}</td>


            </tr>
            </tbody>
        {%endfor%}
        </table>  

        
        
{% endblock %}  